# ========================================================
# AllioBot Configuration (Surat B2B WhatsApp Sales Agent)
# ========================================================

# Server & App Environment
APP_ENV=production
APP_PORT=8000
SECRET_KEY=generate_a_secure_random_key_here

# PostgreSQL Database (Docker internal or host)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/alliobot_db

# Redis Message Queue & Cache
REDIS_URL=redis://redis:6379/0

# Evolution API (Self-Hosted WhatsApp Gateway)
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=alliobot_secret_foss_api_key_2026
EVOLUTION_INSTANCE_NAME=alliobot_primary_instance

# WhatsApp Account & Operations Setup
# YOUR PRIMARY PHONE NUMBER (The single number used for WhatsApp Web pairing)
USER_PHONE_NUMBER=+919876543210

# INTERNAL OPERATIONS WHATSAPP GROUP JID
# Format: 120363XXXXXXXXXXXX@g.us (Obtained via Evolution API /instance/fetchInstances)
OPERATIONS_GROUP_JID=120363028475918234@g.us

# Single-Number Safety & Rate Limits (CRITICAL TO PREVENT BANS)
MAX_OUTBOUND_PER_DAY=25
MIN_OUTBOUND_INTERVAL_SECONDS=180
MAX_OUTBOUND_INTERVAL_SECONDS=420
CIRCUIT_BREAKER_BLOCK_THRESHOLD=0.02

# Local LLM Inference (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Timezone & Geographic Defaults
TIMEZONE=Asia/Kolkata
DEFAULT_CITY=Surat
DEFAULT_STATE=Gujarat
DEFAULT_PRICE_PER_KG=120.0
BULK_DISCOUNT_PRICE_PER_KG=110.0
BULK_DISCOUNT_MIN_KG=12.0
